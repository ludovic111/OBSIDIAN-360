# Off-console X11 regression environment. Provide the pinned upstream archive
# as icewm-source.tar.gz in a small build context; never use the research repo.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make cmake pkg-config gettext python3 python3-tk xvfb x11-utils \
    xdotool fonts-dejavu-core libxtst6 libx11-dev libxft-dev libxrandr-dev \
    libxinerama-dev libxcomposite-dev libxcursor-dev libxdamage-dev \
    libxfixes-dev libsm-dev libice-dev libimlib2-dev \
    && rm -rf /var/lib/apt/lists/*
COPY icewm-source.tar.gz /tmp/icewm-source.tar.gz
RUN echo 'bf5bae7f4a00bd3a561507a5de34b95d45dd28a17f04fa6cdfee17d331a3ad43  /tmp/icewm-source.tar.gz' | sha256sum -c - \
    && mkdir /src && tar -xzf /tmp/icewm-source.tar.gz -C /src --strip-components=1 \
    && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release -DENABLE_NLS=OFF \
    && cmake --build /build --target icewm -j4 \
    && mkdir -p /opt/icewm && cp /build/icewm /opt/icewm/icewm \
    && dpkg-query -W > /opt/icewm/packages.txt
WORKDIR /workspace
