 static int snd_xenon_pcm_hw_free(struct snd_pcm_substream *substream)
 {
-	return snd_pcm_lib_free_pages(substream);
+	struct snd_xenon *chip = snd_pcm_substream_chip(substream);
+	struct playback_device *device;
+	int i;
+
+	spin_lock_irq(&chip->lock);
+	for (i = 0; i < 2; i++) {
+		device = &chip->devices[i];
+		if (device->playback_substream != substream)
+			continue;
+		writel(0, chip->iobase_virt + 0x08 + i * 0x10);
+		readl(chip->iobase_virt + 0x08 + i * 0x10);
+		device->state = 1;
+		device->buffer_bytes = 0;
+		device->period_bytes = 0;
+		device->descr_bytes = 0;
+		break;
+	}
+	spin_unlock_irq(&chip->lock);
+	/* PCM core frees after this callback. Timer synchronization comes next. */
+	return 0;
 }
 
