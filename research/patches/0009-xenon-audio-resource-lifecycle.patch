+
+static void snd_xenon_card_free(struct snd_card *card)
+{
+	struct snd_xenon *chip = card->private_data;
+
+	if (!chip)
+		return;
+	snd_xenon_quiesce(chip);
+	if (chip->descr_base_virt)
+		dma_free_coherent(&chip->pci->dev, DESCRIPTOR_BUFFER_SIZE * 2,
+				  chip->descr_base_virt, chip->descr_base_phys);
+	if (chip->iobase_virt)
+		iounmap(chip->iobase_virt);
+	if (chip->regions_requested)
+		pci_release_regions(chip->pci);
+	if (chip->pci_enabled)
+		pci_disable_device(chip->pci);
+	card->private_data = NULL;
+	kfree(chip);
+}
+
+static int snd_xenon_init(struct snd_xenon *chip)
+{
+	unsigned char smc_snd[16] = {0x8d, 1, 1};
+	int err;
+
+	/* Preserve the DMA API handle verbatim, including for its eventual free. */
+	chip->descr_base_virt = dma_alloc_coherent(&chip->pci->dev,
+		DESCRIPTOR_BUFFER_SIZE * 2, &chip->descr_base_phys, GFP_KERNEL);
+	if (!chip->descr_base_virt)
+		return -ENOMEM;
+
+	if (!xenon_smc_ready())
+		return -EPROBE_DEFER;
+	err = xenon_smc_message(smc_snd);
+	if (err)
+		return err;
+
+	/* Polling will be used until IRQ ownership/acknowledgement is understood. */
+	pci_intx(chip->pci, 0);
 	writel(0, chip->iobase_virt + 0x08);
 	writel(0x2000000, chip->iobase_virt + 0x08);
 	writel(chip->descr_base_phys, chip->iobase_virt + 0x00);
-
 	writel(0, chip->iobase_virt + 0x18);
 	writel(0x2000000, chip->iobase_virt + 0x18);
 	writel(chip->descr_base_phys + DESCRIPTOR_BUFFER_SIZE,
 		chip->iobase_virt + 0x10);
-
-	/* Enable IRQ output */
-	snd_xenon_set_irq_flag(chip, IRQ_ENABLE);
-
-	spin_unlock_irqrestore(&chip->lock, flags);
-}
