+	unsigned long flags;
+	int ret = -EBUSY;
+
+	if (cmd != SNDRV_PCM_IOCTL1_RESET)
+		return snd_pcm_lib_ioctl(substream, cmd, arg);
+	snd_pcm_stream_lock_irqsave(substream, flags);
+	spin_lock(&chip->lock);
+	if (device->playback_substream != substream)
+		device = &chip->devices[1];
+	if (!chip->shutting_down && device->playback_substream == substream &&
+	    device->state == 2 && !device->queue.logical_bytes &&
+	    !device->queue.queued_bytes && !device->queue.write_pos &&
+	    !device->queue.draining) {
+		device->appl_ptr = 0;
+		substream->runtime->status->hw_ptr = 0;
+		substream->runtime->hw_ptr_wrap = 0;
+		ret = 0;
+	}
+	spin_unlock(&chip->lock);
+	snd_pcm_stream_unlock_irqrestore(substream, flags);
+	return ret;
+}
