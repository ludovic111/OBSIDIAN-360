+/* All helpers below run under chip->lock. Data must precede publication. */
+static void snd_xenon_publish(struct playback_device *device,
+			     const struct obs_audio_plan *plan)
+{
+	struct snd_pcm_runtime *runtime = device->playback_substream->runtime;
+
+	if (!plan->publish)
+		return;
+	if (plan->zero_bytes)
+		memset(runtime->dma_area + plan->zero_offset, 0, plan->zero_bytes);
+	dma_wmb();
+	writel(plan->last_descriptor << 8,
+	       device->chip->iobase_virt + 0x04 + device->dev_id * 0x10);
+}
+
+static bool snd_xenon_start_position_ok(struct playback_device *device,
+				      const struct obs_audio_queue *queue)
+{
+	return device->dma_started || !queue->queued_bytes ||
+	       snd_xenon_position(device) == queue->read_pos;
+}
+
+static void snd_xenon_start_dma(struct playback_device *device)
+{
+	struct snd_xenon *chip = device->chip;
+	u32 reg;
+
+	if (device->state != 3 || device->dma_started || !device->queue.queued_bytes)
+		return;
+	device->last_position = device->queue.read_pos;
+	device->last_poll = device->last_progress = ktime_get();
+	dma_wmb();
+	reg = readl(chip->iobase_virt + 0x08 + device->dev_id * 0x10);
+	writel(reg | 0x1000000, chip->iobase_virt + 0x08 + device->dev_id * 0x10);
+	device->dma_started = true;
+}
+
+static int snd_xenon_ack(struct snd_pcm_substream *substream)
+{
+	struct snd_xenon *chip = snd_pcm_substream_chip(substream);
+	struct playback_device *device = &chip->devices[0];
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct obs_audio_queue next;
+	struct obs_audio_plan plan;
+	unsigned int frames;
+	int ret = -EINVAL;
+
+	spin_lock(&chip->lock);
+	if (device->playback_substream != substream)
+		device = &chip->devices[1];
+	if (chip->shutting_down || device->playback_substream != substream ||
+	    (device->state != 2 && device->state != 3) || !device->buffer_bytes)
+		goto out;
+	if (obs_audio_forward_delta(device->appl_ptr, runtime->control->appl_ptr,
+				    runtime->boundary, device->buffer_bytes / 4, &frames))
+		goto out;
+	next = device->queue;
+	if (obs_audio_queue_push(&next, frames * 4, &plan))
+		goto out;
+	if (device->state == 3 && !snd_xenon_start_position_ok(device, &next)) {
+		ret = -EIO;
+		goto out;
+	}
+	/* No fallible operation after commit: ALSA rolls appl_ptr back on error. */
+	device->queue = next;
+	device->appl_ptr = runtime->control->appl_ptr;
+	snd_xenon_publish(device, &plan);
+	snd_xenon_start_dma(device);
+	ret = 0;
+out:
+	spin_unlock(&chip->lock);
+	return ret;
+}
