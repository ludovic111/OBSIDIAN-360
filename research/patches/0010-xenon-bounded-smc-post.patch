+/* Process context only. Busy locks fail immediately; no reply is awaited.
+ * The poll budget assumes every MMIO accessor returns. It cannot bound a
+ * stalled bus transaction, scheduling overhead, or legacy senders.
+ */
+int xenon_smc_post(const unsigned char msg[16], unsigned int timeout_us)
+{
+	unsigned long flags;
+	u32 words[4], status;
+	int ret;
+
+	if (!msg || !(msg[0] & 0x80) || !timeout_us || timeout_us > 1000)
+		return -EINVAL;
+	memcpy(words, msg, sizeof(words));
+	if (!mutex_trylock(&smc_lifecycle_lock))
+		return -EBUSY;
+	if (!smc.base || !smc.send) {
+		ret = -ENODEV;
+		goto out_lifecycle;
+	}
+	if (!spin_trylock_irqsave(&smc.fifo_lock, flags)) {
+		ret = -EBUSY;
+		goto out_lifecycle;
+	}
+
+	ret = readl_poll_timeout_atomic(smc.base + 0x84, status,
+					status & 4, 1, timeout_us);
+	if (!ret) {
+		writel(4, smc.base + 0x84);
+		writesl(smc.base + 0x80, words, 4);
+		writel(0, smc.base + 0x84);
+	}
+	spin_unlock_irqrestore(&smc.fifo_lock, flags);
+out_lifecycle:
+	mutex_unlock(&smc_lifecycle_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(xenon_smc_post);
