+/* Software conversion only: this does not program an oscillator or PLL.
+ * Opt-in because firmware's nominal 50 MHz is inaccurate on the measured
+ * console, but that measurement does not characterize every board revision.
+ */
+static unsigned long xenon_tb_override __initdata;
+
+static int __init xenon_parse_tb_hz(char *value)
+{
+	unsigned long hz;
+
+	if (!value || kstrtoul(value, 10, &hz))
+		return -EINVAL;
+	/* Known firmware value and the value supported by E69/LibXenon. */
+	if (hz != 50000000UL && hz != 49875000UL)
+		return -EINVAL;
+	xenon_tb_override = hz;
+	return 0;
+}
+early_param("xenon_tb_hz", xenon_parse_tb_hz);
+
+static void __init xenon_calibrate_decr(void)
+{
+	generic_calibrate_decr();
+	if (xenon_tb_override) {
+		pr_info("Xenon: timebase conversion %lu Hz (firmware %lu Hz)\n",
+			xenon_tb_override, ppc_tb_freq);
+		ppc_tb_freq = xenon_tb_override;
+	}
+}
 
